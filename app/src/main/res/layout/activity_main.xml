<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶部状态 -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BridgeApp 初始化"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/test_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="检测 SHIZUKU 授权"
        android:layout_marginBottom="12dp"/>

    <!-- 一键扫描按钮 -->
    <Button
        android:id="@+id/scan_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 一键扫描（设备信息汇总）"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <!-- 快捷命令（限高滚动） -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="常用命令（点击直接执行）"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginBottom="4dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="8dp">
        <LinearLayout
            android:id="@+id/quick_cmd_box"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>

    <!-- 自定义命令 -->
    <EditText
        android:id="@+id/cmd_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="输入 shell 命令"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/exec_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="执行"/>

        <Button
            android:id="@+id/clear_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清空"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- 结果区 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#11000000"
        android:padding="6dp"
        android:layout_marginBottom="8dp">
        <TextView
            android:id="@+id/result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="结果将显示在这里..."
            android:textSize="12sp"
            android:typeface="monospace"
            android:textIsSelectable="true"/>
    </ScrollView>

    <!-- 导出操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/copy_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 复制结果"/>

        <Button
            android:id="@+id/save_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💾 保存为文件"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</LinearLayout>
