<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BridgeApp 初始化"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/test_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="检测 SHIZUKU 授权"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/scan_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 一键扫描（设备信息汇总）"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="常用命令（点击执行 / 长按删除）"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/add_cmd_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ 添加"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="6dp"/>
    </LinearLayout>

    <ListView
        android:id="@+id/quick_list"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/cmd_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="输入 shell 命令"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/exec_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="执行"/>

        <Button
            android:id="@+id/clear_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清空"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#11000000"
        android:padding="6dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="结果将显示在这里..."
            android:textSize="12sp"
            android:typeface="monospace"
            android:textIsSelectable="true"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/copy_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 复制"/>

        <Button
            android:id="@+id/save_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💾 保存"
            android:layout_marginStart="6dp"/>

        <Button
            android:id="@+id/share_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📤 分享"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

</LinearLayout>
